@api_router.get(\"/devices\", response_model=List[Device])
async def list_devices():
    items = await db.devices.find({}, {\"_id\": 0}).to_list(500)
    return items


@api_router.post(\"/devices\", response_model=Device)
async def add_device(payload: DeviceCreate):
    d = Device(
        name=payload.name,
        type=payload.type,
        mac=rand_mac(),
        ip=rand_ip(),
        signal_strength=random.randint(55, 95),
        band=random.choice([\"5 GHz\", \"2.4 GHz\"]),
        connected_since=now_iso(),
        is_online=True,
        data_usage_mb=round(random.uniform(5, 200), 1),
    )
    await db.devices.insert_one(d.model_dump())
    return d


@api_router.delete(\"/devices/{device_id}\")
async def remove_device(device_id: str):
    res = await db.devices.delete_one({\"id\": device_id})
    if res.deleted_count == 0:
        raise HTTPException(status_code=404, detail=\"Device not found\")
    return {\"deleted\": True, \"id\": device_id}


@api_router.post(\"/devices/{device_id}/toggle\", response_model=Device)
async def toggle_device(device_id: str):
    doc = await db.devices.find_one({\"id\": device_id}, {\"_id\": 0})
    if not doc:
        raise HTTPException(status_code=404, detail=\"Device not found\")
    new_status = not doc.get(\"is_online\", True)
    await db.devices.update_one({\"id\": device_id}, {\"$set\": {\"is_online\": new_status}})
    doc[\"is_online\"] = new_status
    return doc


