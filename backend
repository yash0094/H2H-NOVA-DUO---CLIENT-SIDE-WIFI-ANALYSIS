def rand_mac() -> str:
    return \":\".join(f\"{random.randint(0, 255):02X}\" for _ in range(6))


def rand_ip() -> str:
    return f\"192.168.1.{random.randint(2, 250)}\"


async def ensure_seed():
    if await db.devices.count_documents({}) == 0:
        for d in SEED_DEVICES:
            doc = Device(
                name=d[\"name\"],
                type=d[\"type\"],
                mac=rand_mac(),
                ip=rand_ip(),
                signal_strength=d[\"signal\"],
                band=d[\"band\"],
                connected_since=(datetime.now(timezone.utc) - timedelta(hours=random.randint(1, 240))).isoformat(),
                is_online=True,
                data_usage_mb=round(random.uniform(50, 4000), 1),
            ).model_dump()
            await db.devices.insert_one(doc)

    if await db.settings.count_documents({}) == 0:
        await db.settings.insert_one({\"_key\": \"global\", **Settings().model_dump()})

    if await db.notifications.count_documents({}) == 0:
        seeds = [
            {\"title\": \"Weak signal detected\", \"body\": \"Nest Hub signal dropped to 63%. Consider repositioning.\", \"type\": \"warning\"},
            {\"title\": \"Firmware update available\", \"body\": \"A new router firmware (v2.14.3) is ready to install.\", \"type\": \"info\"},
            {\"title\": \"Speed test completed\", \"body\": \"Download 128 Mbps · Upload 45 Mbps · Latency 14 ms\", \"type\": \"success\"},
        ]
        for s in seeds:
            await db.notifications.insert_one(Notification(
                title=s[\"title\"], body=s[\"body\"], type=s[\"type\"], created_at=now_iso()
            ).model_dump())


