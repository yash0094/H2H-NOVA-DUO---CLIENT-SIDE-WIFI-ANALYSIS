# -----------------------
# Models
# -----------------------
def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


class DashboardStats(BaseModel):
    model_config = ConfigDict(extra=\"ignore\")
    health_score: int
    health_max: int = 100
    download_mbps: float
    upload_mbps: float
    latency_ms: int
    band: str
    channel: int
    channel_quality: str
    devices_connected: int
    stable: bool
    status_message: str
    greeting: str
    updated_at: str


class Device(BaseModel):
    model_config = ConfigDict(extra=\"ignore\")
    id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    name: str
    type: str  # phone / laptop / tv / tablet / iot / console / desktop
    mac: str
    ip: str
    signal_strength: int  # 0-100
    band: str  # 2.4 GHz / 5 GHz
    connected_since: str
    is_online: bool = True
    data_usage_mb: float = 0.0


class DeviceCreate(BaseModel):
    name: str
    type: str


class ScanProblem(BaseModel):
    title: str
    description: str
    severity: str  # low / medium / high


class ScanSolution(BaseModel):
    id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    title: str
    description: str
    action: str


class ScanResult(BaseModel):
    model_config = ConfigDict(extra=\"ignore\")
    id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    started_at: str
    completed_at: Optional[str] = None
    status: str = \"completed\"  # scanning / completed
    signal_strength: int
    speed_download: float
    speed_upload: float
    latency_ms: int
    best_channel: int
    problems: List[ScanProblem] = []
    solutions: List[ScanSolution] = []
    summary: str


class SecurityReport(BaseModel):
    model_config = ConfigDict(extra=\"ignore\")
    id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    scanned_at: str
    score: int  # 0-100
    encryption: str  # WPA2 / WPA3 / WEP / OPEN
    firewall_enabled: bool
    guest_network_isolated: bool
    weak_password: bool
    open_ports: List[int] = []
    suspicious_devices: int = 0
    issues: List[Dict[str, Any]] = []
    recommendations: List[str] = []


class Notification(BaseModel):
    model_config = ConfigDict(extra=\"ignore\")
    id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    title: str
    body: str
    type: str  # info / warning / success
    created_at: str
    read: bool = False


class Settings(BaseModel):
    model_config = ConfigDict(extra=\"ignore\")
    notifications_enabled: bool = True
    auto_scan: bool = True
    scan_interval_min: int = 60
    theme: str = \"light\"
    background_monitoring: bool = True
    share_diagnostics: bool = False


class OptimizationTip(BaseModel):
    id: str
    text: str
    done: bool = True


