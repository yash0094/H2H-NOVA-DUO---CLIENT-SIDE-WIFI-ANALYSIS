# ---- Security ----
@api_router.post(\"/security/scan\", response_model=SecurityReport)
async def security_scan():
    weak_password = random.random() < 0.2
    firewall = random.random() < 0.9
    guest_iso = random.random() < 0.75
    encryption = random.choice([\"WPA3\", \"WPA2\", \"WPA2\"])
    open_ports = random.sample([21, 22, 23, 25, 80, 443, 3389, 8080], k=random.randint(0, 2))
    suspicious = random.randint(0, 1)

    issues = []
    recs = []
    if weak_password:
        issues.append({\"title\": \"Weak WiFi password\", \"severity\": \"high\"})
        recs.append(\"Change to a password with 12+ characters including symbols.\")
    if not firewall:
        issues.append({\"title\": \"Firewall disabled\", \"severity\": \"high\"})
        recs.append(\"Enable your router's firewall for baseline protection.\")
    if not guest_iso:
        issues.append({\"title\": \"Guest network not isolated\", \"severity\": \"medium\"})
        recs.append(\"Enable client isolation on the guest network.\")
    if open_ports:
        issues.append({\"title\": f\"Open ports detected: {', '.join(str(p) for p in open_ports)}\", \"severity\": \"medium\"})
        recs.append(\"Close unused ports in your router settings.\")
    if suspicious:
        issues.append({\"title\": f\"{suspicious} suspicious device(s) seen\", \"severity\": \"medium\"})
        recs.append(\"Review connected devices and block unknown ones.\")
    if encryption != \"WPA3\":
        recs.append(\"Upgrade to WPA3 encryption if your router supports it.\")

    score = 100
    score -= 25 if weak_password else 0
    score -= 20 if not firewall else 0
    score -= 10 if not guest_iso else 0
    score -= 5 * len(open_ports)
    score -= 10 * suspicious
    score = max(35, min(100, score))

    report = SecurityReport(
        scanned_at=now_iso(),
        score=score,
        encryption=encryption,
        firewall_enabled=firewall,
        guest_network_isolated=guest_iso,
        weak_password=weak_password,
        open_ports=open_ports,
        suspicious_devices=suspicious,
        issues=issues,
        recommendations=recs or [\"You're all set. No action needed right now.\"],
    )
    await db.security_reports.insert_one(report.model_dump())
    return report


@api_router.get(\"/security/latest\", response_model=SecurityReport)
async def latest_security():
    doc = await db.security_reports.find_one({}, {\"_id\": 0}, sort=[(\"scanned_at\", -1)])
    if not doc:
        # generate one on first read
        return await security_scan()
    return doc


