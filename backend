@api_router.post(\"/scan\", response_model=ScanResult)
async def run_scan():
    # Simulate analysis duration with a tiny sleep; frontend drives the animation
    await asyncio.sleep(0.2)
    problem = random.choice(PROBLEM_BANK)
    result = ScanResult(
        started_at=now_iso(),
        completed_at=now_iso(),
        status=\"completed\",
        signal_strength=random.randint(55, 92),
        speed_download=round(random.uniform(60, 180), 0),
        speed_upload=round(random.uniform(25, 60), 0),
        latency_ms=random.randint(8, 40),
        best_channel=random.choice([36, 40, 44, 48]),
        problems=[ScanProblem(**problem)],
        solutions=[ScanSolution(**s) for s in problem[\"solutions\"]],
        summary=problem[\"title\"],
    )
    doc = result.model_dump()
    await db.scans.insert_one(doc)
    return result


