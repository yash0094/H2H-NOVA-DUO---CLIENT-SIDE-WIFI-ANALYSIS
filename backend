def greeting_for_now() -> str:
    h = datetime.now(timezone.utc).hour
    if 5 <= h < 12:
        return \"Good Morning!\"
    if 12 <= h < 17:
        return \"Good Afternoon!\"
    if 17 <= h < 22:
        return \"Good Evening!\"
    return \"Good Night!\"


def make_dashboard() -> Dict[str, Any]:
    health = random.randint(78, 94)
    download = round(random.uniform(75, 160), 0)
    upload = round(random.uniform(28, 60), 0)
    latency = random.randint(8, 32)
    channel = random.choice([36, 40, 44, 48, 149])
    return {
        \"health_score\": health,
        \"health_max\": 100,
        \"download_mbps\": download,
        \"upload_mbps\": upload,
        \"latency_ms\": latency,
        \"band\": \"5 GHz\",
        \"channel\": channel,
        \"channel_quality\": \"Best\",
        \"devices_connected\": 7,
        \"stable\": True,
        \"status_message\": \"Your WiFi connection is stable.\",
        \"greeting\": greeting_for_now(),
        \"updated_at\": now_iso(),
    }


